{
  "name": "replay-trader-cn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "tsx scripts/run-tests.mjs",
    "test:watch": "tsx --watch scripts/run-tests.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.10",
    "vite": "^8.2.1"
  },
  "description": "中文版交易复盘与模拟下单应用",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanghuaiyu6/K-.git"
  },
  "keywords": [
    "replay-trader",
    "trading-simulator",
    "zh-cn"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yanghuaiyu6/K-/issues"
  },
  "homepage": "https://github.com/yanghuaiyu6/K-#readme"
}
